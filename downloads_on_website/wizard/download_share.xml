<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_documents_share_wizard_inherit_download_url" model="ir.ui.view">
        <field name="name">view.documents.share.wizard.inherit.download.url</field>
        <field name="model">documents.share</field>
        <field name="inherit_id" ref="documents.share_view_form_popup"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='full_url']" position="after">
                <field name="x_aa_ol_download_link" widget="CopyClipboardChar" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>