<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_link_ceritficates" model="ir.actions.act_window">
        <field name="name">Link Ceritficates</field>
        <field name="res_model">document.flyers.view</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree</field>
        <field name="target">new</field>
        <field name="view_id" eval="False"/>
    </record>
    <record id="document_view_search2" model="ir.ui.view">
        <field name="name">Document search view 2</field>
        <field name="model">document.flyers.view</field>
        <field name="arch" type="xml">
            <search string="Certificates">
                <field name="x_ad_ol_name" string="Document"/>
                <searchpanel>
                    <field name="x_ad_ol_folder_id" select="multi" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="documents_view_list2" model="ir.ui.view">
        <field name="name">Certificates</field>
        <field name="model">document.flyers.view</field>
        <field name="inherit_id" ref="sale_custom_report.documents_view_list1"/>

        <field name="arch" type="xml">
             <xpath expr="//header/button[@name='action_attach_flyers']" position="after">

                   <button name="action_link_certificates"
                            string="Link Certificates"
                            type="object" invisible="context.get('hide_button_link_certification')" />

                    <button name="action_un_link_certificates"
                            string="Un Link Certificates"
                            type="object" invisible="context.get('hide_button_un_link_certification')" />
             </xpath>


        </field>
    </record>
</odoo>